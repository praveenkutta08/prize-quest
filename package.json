{
  "name": "@pq/root",
  "version": "0.0.0",
  "private": true,
  "description": "Prize Quest patron module — pnpm workspace root",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pq/playground dev",
    "dev:luminara": "pnpm --filter @pq/luminara-web dev",
    "build": "turbo run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scope-widgets": "node tooling/scope-widgets.mjs",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pq/eslint-config": "workspace:*",
    "@pq/tsconfig": "workspace:*",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/web-components": "^10.4.2",
    "@storybook/web-components-vite": "^10.4.2",
    "@types/react": "^19.2.0",
    "eslint": "^10.4.1",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "lit": "^3.3.3",
    "pnpm": "11.5.1",
    "prettier": "^3.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.4.2",
    "turbo": "^2.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  }
}
